# =========================================================
# GameStock - variáveis do back-end no RENDER (EXEMPLO)
# No Render NÃO crie arquivo .env: cadastre cada chave em
# Web Service > Environment > Environment Variables.
# (O Render já define a variável PORT sozinho.)
# =========================================================

# --- Banco PostgreSQL do Render ---
# Jeito mais fácil: cole a "Internal Database URL" do seu PostgreSQL
# (Render > seu banco > Connections). Com ela, DB_HOST..DB_PASS não são usados.
DATABASE_URL=

# Ou preencha separado:
DB_DRIVER=pgsql
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=

# true só se usar a URL EXTERNA do banco (a interna não precisa de SSL)
DB_SSL=false

# --- Endereço do front-end (Static Site) liberado no CORS ---
# Ex.: https://front-end-gamestock.onrender.com  (vários: separe por vírgula)
FRONTEND_URL=

# Em produção deixe false (true mostra detalhes técnicos dos erros)
APP_DEBUG=false
