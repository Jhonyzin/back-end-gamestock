# =========================================================
# GameStock - variáveis do back-end no RENDER (EXEMPLO)
# No Render NÃO crie arquivo .env: cadastre cada chave em
# Web Service > Environment > Environment Variables.
# (O Render já define a variável PORT sozinho.)
# =========================================================

# --- MySQL externo (o Render não oferece MySQL gerenciado) ---
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# true se o seu provedor de MySQL exigir SSL
DB_SSL=false
# certificado da autoridade (opcional; a imagem já tem /etc/ssl/certs/ca-certificates.crt)
DB_SSL_CA=

# --- Endereço do front-end (Static Site) liberado no CORS ---
# Ex.: https://gamestock.onrender.com  (vários: separe por vírgula)
FRONTEND_URL=

# Em produção deixe false (não mostra detalhes técnicos dos erros)
APP_DEBUG=false
